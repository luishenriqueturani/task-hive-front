# =============================================================================
# Task Hive — Frontend (.env)
# Copie: cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Desenvolvimento local (npm run dev + backend em localhost:3001)
# -----------------------------------------------------------------------------

# URL do Nest — só servidor (NUNCA NEXT_PUBLIC_* para tokens).
BACKEND_API_BASE_URL=http://localhost:3001

# Socket.IO no browser. Em dev puro pode omitir; timetrack usa /api/runtime.
# PUBLIC_WS_URL=http://localhost:3000

# Redirects de sessão / CSRF — opcionais em dev (defaults internos).
# PUBLIC_APP_URL=http://localhost:3000
# CSRF_ALLOWED_ORIGINS=http://localhost:3000

# Cookies Secure=false enquanto usar HTTP local.
SESSION_COOKIE_SECURE=false

# -----------------------------------------------------------------------------
# Produção — Docker Compose na raiz (serviço `web`)
# Estas variáveis vêm do compose; documentadas aqui para referência.
# Defina PUBLIC_* e CSRF no .env da raiz (backend/.env + link-compose-env.sh).
# -----------------------------------------------------------------------------

# BACKEND_API_BASE_URL=http://api:3001          # rede Docker (automático)
# SESSION_COOKIE_SECURE=false                   # LAN HTTP (compose default)
# ENABLE_HSTS=false                             # só true com HTTPS terminado

# URL que o utilizador abre no browser (Nginx), sem barra final:
# PUBLIC_APP_URL=http://192.168.1.34:8080
# PUBLIC_WS_URL=http://192.168.1.34:8080
# CSRF_ALLOWED_ORIGINS=http://192.168.1.34:8080,http://orangepi.local:8080

# -----------------------------------------------------------------------------
# Sessão (opcional — defaults abaixo)
# -----------------------------------------------------------------------------

# Alinhar com JWT_ACCESS_EXPIRES_IN / JWT_REFRESH_EXPIRES_DAYS no backend.
# SESSION_ACCESS_MAX_AGE_SECONDS=3600
# SESSION_REFRESH_MAX_AGE_SECONDS=2592000

# -----------------------------------------------------------------------------
# Segurança HTTP (next.config.ts)
# -----------------------------------------------------------------------------

# CSP em modo observação (não bloqueia):
# CSP_REPORT_ONLY=true

# HSTS — apenas com HTTPS real (não usar em HTTP doméstico):
# ENABLE_HSTS=true

# -----------------------------------------------------------------------------
# OpenAPI / Orval (dev)
# -----------------------------------------------------------------------------

# Origem do Swagger para npm run api:fetch-spec
# OPENAPI_URL=http://localhost:3001/api-json

# -----------------------------------------------------------------------------
# E2E Playwright (opcional — defaults no playwright.config.ts)
# -----------------------------------------------------------------------------

# E2E_PORT=3100
# MOCK_BACKEND_PORT=4099
