# URL base do backend (apenas servidor — não usar NEXT_PUBLIC).
# O proxy em /api/bff encaminha cookies; não coloque tokens em variáveis públicas.
# Em Docker (compose na raiz): o serviço `web` usa http://api:3001 automaticamente.
BACKEND_API_BASE_URL=http://localhost:3001

# URL pública do Socket.IO para o browser (obrigatório em produção).
# Deve ser o mesmo host:porta que o utilizador usa no Nginx (sem barra final).
# Em Docker na LAN: http://192.168.1.18:8080 (ajusta ao teu IP e HTTP_PORT).
PUBLIC_WS_URL=http://127.0.0.1:8080

# CSP: true = Report-Only (observar violações); omitir ou false = enforce.
# CSP_REPORT_ONLY=true

# Cookie de sessão Secure. Em HTTP doméstico: false.
# Em production local sem Compose, o default é true — define false se usares HTTP.
# SESSION_COOKIE_SECURE=false

# Duração dos cookies (segundos) — alinhar com JWT_ACCESS_EXPIRES_IN / JWT_REFRESH_EXPIRES_DAYS
# SESSION_ACCESS_MAX_AGE_SECONDS=3600
# SESSION_REFRESH_MAX_AGE_SECONDS=2592000

# HSTS (só com HTTPS). Em casa com HTTP: false (default no Compose).
# ENABLE_HSTS=false

# Opcional: origem do OpenAPI para npm run api:fetch-spec
# OPENAPI_URL=http://localhost:3001/api-json
