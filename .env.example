# URL base do backend (apenas servidor — não usar NEXT_PUBLIC).
# O proxy em /api/bff encaminha cookies; não coloque tokens em variáveis públicas.
# Em Docker (compose na raiz): o serviço `web` usa http://api:3001 automaticamente.
BACKEND_API_BASE_URL=http://localhost:3001

# URL pública do Socket.IO para o browser (opcional).
# Se vazio, /api/runtime deriva do header Host (funciona por IP atrás do Nginx).
# Em Docker na LAN podes forçar, ex.: http://192.168.1.50:8080
# PUBLIC_WS_URL=

# Cookie de sessão Secure. Em HTTP doméstico: false.
# Em production local sem Compose, o default é true — define false se usares HTTP.
# SESSION_COOKIE_SECURE=false

# HSTS (só com HTTPS). Em casa com HTTP: false (default no Compose).
# ENABLE_HSTS=false

# Opcional: origem do OpenAPI para npm run api:fetch-spec
# OPENAPI_URL=http://localhost:3001/api-json
